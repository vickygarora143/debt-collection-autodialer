<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <!-- 1. LOCKED VIEW (EMERGENCY KILL-SWITCH SCREEN) -->
    <LinearLayout
        android:id="@+id/layoutLocked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCESS REVOKED"
            android:textColor="#EF4444"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="This APK is deactivated by Super Administrator. Local records wiped."
            android:textColor="#94A3B8"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 2. LOGIN VIEW -->
    <LinearLayout
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DebtFlow Dialer"
            android:textColor="#38BDF8"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Telecaller Device Authentication"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etAgentCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="#0F172A"
            android:hint="Agent ID (e.g. AGT001)"
            android:paddingHorizontal="16dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#475569"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAgentPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="#0F172A"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#475569"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnLoginSubmit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2563EB"
            android:text="Authorize &amp; Bind Phone"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. DIALER HUD (HIGH-CONTRAST TELECALLING SCREEN) -->
    <LinearLayout
        android:id="@+id/layoutDialer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvQueueProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Queue: #1 of 250"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAgentImport"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#1E293B"
                    android:text="+ IMPORT"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAudioToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#1E293B"
                    android:text="HEADSET"
                    android:textColor="#10B981"
                    android:textSize="11sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Debtor Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="16dp"
            android:layout_weight="1"
            android:background="#0F172A"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBucket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#78350F"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="BUCKET 2"
                    android:textColor="#FDE68A"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvDpd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DPD: 64 Days"
                    android:textColor="#F87171"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDebtorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Rajesh Kumar Sharma"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLoanAcc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Loan Acc: PL-98241029"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="+91 98765 43210"
                android:textColor="#38BDF8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverdue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="₹ 28,450"
                android:textColor="#F59E0B"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Call Live Status -->
            <TextView
                android:id="@+id/tvCallStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#1E293B"
                android:gravity="center"
                android:padding="10dp"
                android:text="Ready"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCallTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:text="00:00"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 1-Tap Recovery Dispositions (Hidden during active dial, visible on disconnect) -->
        <LinearLayout
            android:id="@+id/layoutDispositions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="6dp"
                android:text="TAG OUTCOME"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2">

                <Button
                    android:id="@+id/btnDispPtp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="#059669"
                    android:text="PTP"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDispBrokenPtp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="#D97706"
                    android:text="Broken PTP"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDispPaid"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="#2563EB"
                    android:text="Paid"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDispRnr"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="#334155"
                    android:text="RNR"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDispBusy"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="#334155"
                    android:text="Busy/Off"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDispWrong"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:backgroundTint="#DC2626"
                    android:text="Wrong #"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </GridLayout>
        </LinearLayout>

        <!-- Bottom Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartDial"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="#059669"
                android:text="Start Auto-Dialing"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPause"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#1E293B"
                android:text="Pause"
                android:textColor="#94A3B8" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
