<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.collection.autodialer">

    <!-- Direct SIM Calling without manual dialing -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Call state monitoring (Ringing, Connected, Ended, Duration) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    
    <!-- Audio Routing (Earphone, Headset, Speakerphone) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- Cloudflare Free Tier Serverless API Sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Keep calling loop active during high-volume shifts -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:label="DebtFlow Dialer"
        android:supportsRtl="true"
        android:theme="@style/Theme.DebtFlowDialer"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
